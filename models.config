{
  "app_name": "BrandMind",
  "app_tagline": "AI brand intelligence that can think.",
  "version": "1.0.0",
  "providers": {
    "groq": {
      "base_url": "https://api.groq.com/openai/v1",
      "timeout_seconds": 25,
      "max_retries": 1
    },
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "timeout_seconds": 30,
      "max_retries": 1
    }
  },
  "stages": {
    "stage1_interview": {
      "name": "Understand & Interview",
      "primary": { "provider": "groq", "model": "qwen/qwen3.8-27b" },
      "fallback": { "provider": "openrouter", "model": "openrouter/free" }
    },
    "stage2_position": {
      "name": "Positioning (Brand Battle)",
      "primary": { "provider": "groq", "model": "qwen/qwen3.8-27b" },
      "fallback": { "provider": "openrouter", "model": "openrouter/free" }
    },
    "stage3_personality": {
      "name": "Personality & Principles",
      "primary": { "provider": "groq", "model": "qwen/qwen3.8-27b" },
      "fallback": { "provider": "openrouter", "model": "openrouter/free" }
    },
    "stage4_antigeneric": {
      "name": "Anti-Generic Engine",
      "primary": { "provider": "groq", "model": "qwen/qwen3.8-27b" },
      "fallback": { "provider": "openrouter", "model": "openrouter/free" }
    },
    "stage5_naming": {
      "name": "Naming & Messaging",
      "primary": { "provider": "groq", "model": "qwen/qwen3.8-27b" },
      "fallback": { "provider": "openrouter", "model": "openrouter/free" }
    },
    "stage6_visuals": {
      "name": "Visual Direction & Identity",
      "primary": { "provider": "groq", "model": "qwen/qwen3.8-27b" },
      "fallback": { "provider": "openrouter", "model": "openrouter/free" }
    },
    "stage7_consistency": {
      "name": "Consistency Critic",
      "primary": { "provider": "groq", "model": "qwen/qwen3.8-27b" },
      "fallback": { "provider": "openrouter", "model": "openrouter/free" }
    },
    "stage8_launchkit": {
      "name": "Launch Kit",
      "primary": { "provider": "groq", "model": "qwen/qwen3.8-27b" },
      "fallback": { "provider": "openrouter", "model": "openrouter/free" }
    }
  },
  "rate_limits": {
    "runs_per_hour_per_ip": 12,
    "requests_per_minute_per_ip": 30
  }
}
